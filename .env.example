# Address the phone reaches the server at (used by `crypta pair`).
CRYPTA_PUBLIC_URL=https://crypta.example.com
# Domain for the built-in HTTPS proxy (docker compose --profile https).
CRYPTA_DOMAIN=crypta.example.com

# Your rclone.conf with a crypt remote on top of a Google Drive remote.
RCLONE_CONF=./rclone.conf
# Name of the crypt remote; may stay empty if the file has only one.
CRYPTA_REMOTE=

# Set to 1 to try the server without Google Drive (encrypted files are kept
# in the data volume instead).
CRYPTA_DEMO=

# Where the core's port is published. Keep it on localhost when Caddy or
# another reverse proxy is in front.
CRYPTA_BIND=127.0.0.1:8080

# Telegram plugin (docker compose --profile telegram).
TELEGRAM_BOT_TOKEN=
# Comma separated numeric user ids allowed to use the bot (send /start to see yours).
TELEGRAM_ALLOWED_USERS=
TELEGRAM_REMOTE_DIR=Telegram
# Optional self-hosted Bot API server, lifts the 20 MB download limit.
TELEGRAM_API_BASE=
